# 统一以 LF 存入仓库，检出时按平台处理，避免行尾在协作时反复变动
* text=auto

*.cs        text eol=crlf
*.xaml      text eol=crlf
*.csproj    text eol=crlf
*.sln       text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.ps1       text eol=crlf
*.md        text eol=lf

*.ico       binary
*.png       binary
*.icns      binary
*.exe       binary
*.dll       binary
