<UserControl x:Class="SciToolbox.Views.RouteChoiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SciToolbox.Views"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <views:StringToVisibilityConverter x:Key="S2V"/>
    </UserControl.Resources>
    <DockPanel MaxHeight="440">
        <Grid DockPanel.Dock="Top" Margin="18,16,12,10">
            <TextBlock Text="{Binding RouteTitle}" Style="{StaticResource HeadlineText}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                    Command="{Binding CloseRouteCommand}" views:A11y.Name="{Binding CloseTip}">
                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE711;"/>
            </Button>
        </Grid>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding RouteHint}" Style="{StaticResource CaptionText}" Margin="18,8,18,4"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding RouteOptions}" Margin="12,0,12,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Command="{Binding ChooseCommand}" Style="{StaticResource GhostButton}"
                                HorizontalContentAlignment="Stretch" Padding="10,8" Margin="0,2"
                                AutomationProperties.Name="{Binding ToolName}">
                            <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" CornerRadius="6" Padding="12,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding ToolName}" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Ink}" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Query}" FontSize="12" FontFamily="Consolas, Cascadia Mono"
                                                   Foreground="{DynamicResource Brush.Ink2}" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                        <TextBlock Text="{Binding Reason}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="{Binding Brush}" CornerRadius="4"
                                            Padding="8,3" VerticalAlignment="Center" Style="{StaticResource Chip}">
                                        <TextBlock Text="{Binding ConfidenceLabel}" Style="{StaticResource ChipText}" TextWrapping="NoWrap"/>
                                    </Border>
                                </Grid>
                            </Border>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
