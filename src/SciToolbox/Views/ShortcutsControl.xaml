<UserControl x:Class="SciToolbox.Views.ShortcutsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SciToolbox.Views"
             DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="18,16,12,10">
            <TextBlock Text="{Binding ShortcutsTitle}" Style="{StaticResource HeadlineText}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                    Command="{Binding CloseShortcutsCommand}" views:A11y.Name="{Binding CloseTip}">
                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE711;"/>
            </Button>
        </Grid>
        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Brush.Divider}"/>
        <TextBlock DockPanel.Dock="Top" Text="{Binding ShortcutsFootnote}" Style="{StaticResource CaptionText}" Margin="18,8,18,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="Rows" Margin="16,10,16,16">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Card}" CornerRadius="6" Padding="14,8" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Keys}" FontFamily="Cascadia Mono, Consolas"
                                           FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Brush.Accent}"
                                           TextWrapping="NoWrap" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Action}" FontSize="12"
                                           Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
