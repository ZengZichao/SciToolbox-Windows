<UserControl x:Class="SciToolbox.Views.AddToCollectionControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SciToolbox.Views"
             DataContext="{Binding DataContext.AddCollectionVmInstance, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="B2V"/>
        <views:BoolToVisibilityConverter x:Key="InvB2V" Invert="True"/>
    </UserControl.Resources>
    <StackPanel Margin="18,16,18,16">
        <Grid Margin="0,0,0,10">
            <TextBlock Text="{Binding Title}" Style="{StaticResource HeadlineText}" VerticalAlignment="Center"/>
            <Button Style="{StaticResource IconButton}" HorizontalAlignment="Right"
                    Command="{Binding DataContext.CloseAddCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                    views:A11y.Name="{Binding DataContext.CloseTip, RelativeSource={RelativeSource AncestorType=Window}}">
                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE711;"/>
            </Button>
        </Grid>
        <TextBlock Text="{Binding Hint}" Style="{StaticResource SmallText}" Margin="0,0,0,10"/>
        <ListBox Style="{StaticResource BareListBox}" ItemsSource="{Binding Options}"
                 SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                 MaxHeight="200" ScrollViewer.VerticalScrollBarVisibility="Auto" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="4,6">
                        <RadioButton GroupName="colpick" Focusable="False"
                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=OneWay}"/>
                        <TextBlock Text="{Binding Name}" FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Ink}" TextWrapping="NoWrap"
                                   TextTrimming="CharacterEllipsis" MaxWidth="320"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Text="{Binding NoCollectionsHint}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"
                   Visibility="{Binding ShowNoCollections, Converter={StaticResource B2V}}"/>

        <!-- 新集合名称：只有选中"新建集合"时才可输入 -->
        <TextBox Style="{StaticResource SearchBox}" MinHeight="30" Margin="0,0,0,12"
                 views:Placeholder.Text="{Binding NamePlaceholder}"
                 IsEnabled="{Binding NewNameEnabled}"
                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}">
            <TextBox.InputBindings>
                <KeyBinding Key="Enter" Command="{Binding ConfirmCommand}"/>
            </TextBox.InputBindings>
        </TextBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="{Binding CancelLabel}" Style="{StaticResource GhostButton}" Margin="0,0,8,0"
                    Command="{Binding DataContext.CloseAddCollectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
            <Button Content="{Binding NewLabel}" Style="{StaticResource PrimaryButton}" Command="{Binding ConfirmCommand}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
