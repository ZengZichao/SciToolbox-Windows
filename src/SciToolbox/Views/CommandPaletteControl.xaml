<UserControl x:Class="SciToolbox.Views.CommandPaletteControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SciToolbox.Views"
             DataContext="{Binding DataContext.PaletteVmInstance, RelativeSource={RelativeSource AncestorType=Window}}">
    <UserControl.Resources>
        <views:BoolToVisibilityConverter x:Key="B2V"/>
        <views:BoolToVisibilityConverter x:Key="InvB2V" Invert="True"/>
    </UserControl.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,0,0,1">
            <DockPanel Margin="14,12">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" Style="{StaticResource GlyphText}" FontSize="14"
                           Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,10,0"/>
                <TextBox x:Name="InputBox" Style="{StaticResource SearchBox}" BorderThickness="0" Background="Transparent"
                         FontSize="14" MinHeight="28" views:Placeholder.Text="{Binding Placeholder}"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" KeyDown="InputBox_KeyDown"/>
            </DockPanel>
        </Border>

        <!-- 底部说明：输入格式（工具:编号）以前完全没有可见提示 -->
        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Divider}" BorderThickness="0,1,0,0" Padding="14,6">
            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding FormatHint}"/>
        </Border>

        <Grid>
            <ListBox x:Name="List" Style="{StaticResource BareListBox}" ItemsSource="{Binding Filtered}"
                     SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                     MouseLeftButtonUp="List_Click"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     Visibility="{Binding HasResults, Converter={StaticResource B2V}}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Glyph}" Style="{StaticResource GlyphText}" FontSize="14"
                                       Foreground="{DynamicResource Brush.Ink3}"/>
                            <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                <TextBlock Text="{Binding Name}" FontSize="13" Foreground="{DynamicResource Brush.Ink}"
                                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding NoMatchLabel}"
                       Visibility="{Binding HasResults, Converter={StaticResource InvB2V}}"/>
        </Grid>
    </DockPanel>
</UserControl>
