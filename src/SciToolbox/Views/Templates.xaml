<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SciToolbox.ViewModels"
                    xmlns:conv="clr-namespace:SciToolbox.Views"
                    xmlns:views="clr-namespace:SciToolbox.Views">

    <conv:BoolToVisibilityConverter x:Key="B2V"/>
    <conv:BoolToVisibilityConverter x:Key="InvB2V" Invert="True"/>
    <conv:StringToVisibilityConverter x:Key="S2V"/>
    <conv:CollectionToVisibilityConverter x:Key="C2V"/>
    <conv:EqualConverter x:Key="EqConv"/>
    <conv:StringEqualsConverter x:Key="StrEq"/>
    <conv:ImageUrlConverter x:Key="UrlImg"/>

    <Style x:Key="GlyphText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="NoWrap"/>
    </Style>

    <!-- 统一的空态 / 提示占位：整体居中 -->
    <Style x:Key="EmptyStateText" TargetType="TextBlock" BasedOn="{StaticResource SmallText}">
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="Margin" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink3}"/>
    </Style>

    <!-- ================= 搜索结果行 ================= -->
    <DataTemplate x:Key="ResultRowTemplate" DataType="{x:Type vm:ResultRowVm}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox Grid.Column="0" VerticalAlignment="Center" Margin="14,0,4,0"
                      Visibility="{Binding DataContext.SelectionMode, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource B2V}}"
                      IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
            <Button Grid.Column="1" Command="{Binding OpenCommand}" Style="{StaticResource GhostButton}"
                    HorizontalContentAlignment="Stretch" Padding="10,10" Background="Transparent">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" MaxHeight="40"/>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallText}" Margin="0,2,0,0"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Visibility="{Binding HasSubtitle, Converter={StaticResource B2V}}"/>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Border Background="{DynamicResource Brush.Window}" CornerRadius="4" Padding="6,1" Margin="0,0,6,0"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1"
                                Visibility="{Binding HasBadge, Converter={StaticResource B2V}}">
                            <TextBlock Text="{Binding Badge}" FontSize="11" FontFamily="Consolas, Cascadia Mono"
                                       Foreground="{DynamicResource Brush.Ink3}" TextWrapping="NoWrap"/>
                        </Border>
                        <TextBlock Text="{Binding Meta}" FontSize="11" Foreground="{DynamicResource Brush.Ink3}"
                                   VerticalAlignment="Center" TextWrapping="NoWrap"
                                   Visibility="{Binding HasMeta, Converter={StaticResource B2V}}"/>
                    </StackPanel>
                </StackPanel>
            </Button>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Command="{Binding FavoriteCommand}"
                    Margin="0,0,12,0" VerticalAlignment="Center"
                    views:A11y.Name="{Binding FavoriteTip}"
                    ToolTip="{Binding FavoriteTip}">
                <TextBlock Style="{StaticResource GlyphText}" Text="{Binding FavoriteGlyph}"
                           Foreground="{DynamicResource Brush.Accent}"/>
            </Button>
        </Grid>
    </DataTemplate>

    <!-- ================= 搜索中栏 ================= -->
    <DataTemplate DataType="{x:Type vm:SearchVm}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" Margin="20,4,20,8">
                <Button DockPanel.Dock="Right" Content="{Binding IdentifyLabel}" Style="{StaticResource GhostButton}"
                        Command="{Binding IdentifyCommand}" Margin="6,0,0,0"/>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Command="{Binding SearchCommand}"
                        Margin="0,0,4,0" views:A11y.Name="{Binding HintLabel}">
                    <TextBlock Style="{StaticResource GlyphText}" Text="&#xE721;"/>
                </Button>
                <TextBox Style="{StaticResource SearchBox}" Tag="MainSearch"
                         views:Placeholder.Text="{Binding Placeholder}"
                         Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>

            <!-- 检索范围 -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding PickerOptions}" Margin="20,0,20,8"
                          Visibility="{Binding HasPicker, Converter={StaticResource B2V}}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <RadioButton GroupName="picker" Margin="0,0,6,6" Style="{StaticResource PillRadioStyle}"
                                     Command="{Binding DataContext.SetPickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                     CommandParameter="{Binding Id}">
                            <RadioButton.IsChecked>
                                <MultiBinding Converter="{StaticResource EqConv}">
                                    <Binding Path="DataContext.SelectedPickerId" RelativeSource="{RelativeSource AncestorType=ItemsControl}"/>
                                    <Binding Path="Id"/>
                                </MultiBinding>
                            </RadioButton.IsChecked>
                            <TextBlock Text="{Binding Label}" TextWrapping="NoWrap"/>
                        </RadioButton>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 结果内筛选 + 批量选择栏 -->
            <StackPanel Grid.Row="2" Margin="20,0,20,6" Visibility="{Binding IsResults, Converter={StaticResource B2V}}">
                <DockPanel Visibility="{Binding HasAnyItems, Converter={StaticResource B2V}}">
                    <Button DockPanel.Dock="Right" Style="{StaticResource GhostButton}"
                            Command="{Binding EnterSelectCommand}" Margin="6,0,0,0"
                            Visibility="{Binding NotSelectionMode, Converter={StaticResource B2V}}">
                        <TextBlock Text="{Binding EnterMultiSelectLabel}" FontSize="12" TextWrapping="NoWrap"/>
                    </Button>
                    <Grid>
                        <TextBox Style="{StaticResource SearchBox}" FontSize="12" MinHeight="28"
                                 views:Placeholder.Text="{Binding FilterPlaceholder}"
                                 Text="{Binding InResultFilter, UpdateSourceTrigger=PropertyChanged}"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                                MinWidth="24" MinHeight="24" Margin="0,0,3,0"
                                Command="{Binding ClearFilterCommand}" views:A11y.Name="{Binding ClearFilterLabel}"
                                Visibility="{Binding FilterActive, Converter={StaticResource B2V}}">
                            <TextBlock Style="{StaticResource GlyphText}" FontSize="11" Text="&#xE711;"/>
                        </Button>
                    </Grid>
                </DockPanel>
                <WrapPanel Margin="0,8,0,0" Visibility="{Binding ShowSelectionBar, Converter={StaticResource B2V}}">
                    <Button Content="{Binding DoneLabel}" Style="{StaticResource GhostButton}"
                            Foreground="{DynamicResource Brush.Accent}" FontSize="12"
                            Command="{Binding DoneSelectCommand}" Margin="0,0,6,0"/>
                    <Button Content="{Binding SelectAllLabel}" Style="{StaticResource GhostButton}"
                            FontSize="12" Command="{Binding ToggleSelectAllCommand}" Margin="0,0,6,0"/>
                    <TextBlock Text="{Binding SelectedCountLabel}" Style="{StaticResource CaptionText}"
                               VerticalAlignment="Center" Margin="4,0,10,0" TextWrapping="NoWrap"/>
                    <Button Content="{Binding CopyIdsLabel}" Style="{StaticResource SecondaryButton}"
                            FontSize="12" Command="{Binding BatchCopyCommand}" Margin="0,0,6,0"/>
                    <Button Content="{Binding BatchFavoriteLabel}" Style="{StaticResource SecondaryButton}"
                            FontSize="12" Command="{Binding BatchFavoriteCommand}" Margin="0,0,6,0"/>
                    <Button Content="{Binding AddCollectionLabel}" Style="{StaticResource SecondaryButton}"
                            FontSize="12" Command="{Binding BatchAddCollectionCommand}" Margin="0,0,6,0"/>
                    <Button Content="{Binding ExportLabel}" Style="{StaticResource SecondaryButton}"
                            FontSize="12" Command="{Binding BatchExportCommand}"/>
                </WrapPanel>
            </StackPanel>

            <Border Grid.Row="3" Height="1" Background="{DynamicResource Brush.Divider}" VerticalAlignment="Bottom"/>

            <!-- 结果计数 -->
            <TextBlock Grid.Row="3" Margin="20,6,20,4" Text="{Binding Subtitle}"
                       Style="{StaticResource CaptionText}" TextWrapping="NoWrap" VerticalAlignment="Top"
                       Visibility="{Binding Subtitle, Converter={StaticResource S2V}}"/>

            <!-- 内容区 -->
            <Grid Grid.Row="4">
                <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding Placeholder}"
                           Visibility="{Binding IsHome, Converter={StaticResource B2V}}"/>

                <ProgressBar IsIndeterminate="True" Style="{StaticResource ThinProgress}" Width="120"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="{Binding IsLoading, Converter={StaticResource B2V}}"/>

                <StackPanel Margin="28,0" MaxWidth="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                            Visibility="{Binding IsError, Converter={StaticResource B2V}}">
                    <TextBlock Style="{StaticResource GlyphText}" FontSize="28" Text="&#xE783;"
                               Foreground="{DynamicResource Brush.SemanticError}"/>
                    <TextBlock Text="{Binding ErrorText}" Foreground="{DynamicResource Brush.Ink2}" FontSize="13"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"/>
                    <Button Content="{Binding RetryLabel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding RetryCommand}" HorizontalAlignment="Center" Margin="0,14,0,0"/>
                </StackPanel>

                <Grid Visibility="{Binding IsResults, Converter={StaticResource B2V}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <views:ResultList Grid.Row="0" Style="{StaticResource BareListBox}"
                                      ItemsSource="{Binding DisplayItems}"
                                      ItemTemplate="{StaticResource ResultRowTemplate}"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Stretch"/>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                MaxWidth="420" Margin="28,0"
                                Visibility="{Binding ShowEmptyNoResult, Converter={StaticResource B2V}}">
                        <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding EmptyResultsLabel}" Margin="0"/>
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding NoResultGuidance}"
                                   TextAlignment="Center" Margin="0,6,0,0"/>
                        <Button Content="{Binding GlobalSearchLabel}" Style="{StaticResource SecondaryButton}"
                                FontSize="12" Command="{Binding OpenGlobalSearchCommand}"
                                HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="28,0" Visibility="{Binding ShowEmptyFilter, Converter={StaticResource B2V}}">
                        <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding EmptyResultsLabel}" Margin="0"/>
                        <Button Content="{Binding ClearFilterLabel}" Style="{StaticResource SecondaryButton}"
                                FontSize="12" Command="{Binding ClearFilterCommand}"
                                HorizontalAlignment="Center" Margin="0,12,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Margin="20,0">
                        <Button Content="{Binding LoadMoreLabel}" Style="{StaticResource GhostButton}"
                                Command="{Binding LoadMoreCommand}"
                                Visibility="{Binding ShowLoadMore, Converter={StaticResource B2V}}"
                                HorizontalAlignment="Center" Margin="0,6,0,4"/>
                        <TextBlock Text="{Binding LoadMoreError}" Foreground="{DynamicResource Brush.SemanticError}"
                                   FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12"
                                   Visibility="{Binding HasLoadMoreError, Converter={StaticResource B2V}}"/>
                        <TextBlock Style="{StaticResource CaptionText}" Text="{Binding SourceNoteLabel}"
                                   HorizontalAlignment="Center" Margin="0,0,0,10"
                                   Visibility="{Binding SourceNoteLabel, Converter={StaticResource S2V}}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </DataTemplate>

    <!-- ================= 详情右栏 ================= -->
    <DataTemplate DataType="{x:Type vm:DetailVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Background="{DynamicResource Brush.Window}">
            <StackPanel>
                <Border Height="3" Background="{Binding AccentBrush}"/>
                <StackPanel Margin="26,20,26,0">
                    <TextBlock Text="{Binding HeaderTitle}" Style="{StaticResource LargeTitleText}"/>
                    <TextBlock Text="{Binding HeaderSubtitle}" Style="{StaticResource SmallText}" Margin="0,4,0,0"
                               Visibility="{Binding HeaderSubtitle, Converter={StaticResource S2V}}"/>
                    <ItemsControl ItemsSource="{Binding HeaderMeta}" Margin="0,8,0,0"
                                  Visibility="{Binding HeaderMeta, Converter={StaticResource C2V}}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Padding="8,2" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <WrapPanel Margin="0,10,0,0">
                        <Button Style="{StaticResource IconButton}" Command="{Binding ToggleFavoriteCommand}"
                                Margin="0,0,4,0" views:A11y.Name="{Binding FavoriteTip}">
                            <TextBlock Style="{StaticResource GlyphText}" Text="{Binding FavoriteGlyph}"
                                       Foreground="{DynamicResource Brush.Accent}"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding AddToCollectionCommand}"
                                Margin="0,0,4,0" views:A11y.Name="{Binding CollectionTip}">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE710;"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Command="{Binding AddToCompareCommand}"
                                Margin="0,0,4,0" views:A11y.Name="{Binding CompareTip}">
                            <TextBlock Style="{StaticResource GlyphText}" Text="&#xE8A4;"/>
                        </Button>
                        <Button Content="{Binding ViewWebLabel}" Style="{StaticResource GhostButton}"
                                Command="{Binding OpenWebCommand}" FontSize="12"
                                Visibility="{Binding WebUrl, Converter={StaticResource S2V}}"/>
                    </WrapPanel>
                </StackPanel>

                <Grid Margin="26,16,26,0" Visibility="{Binding HasImage, Converter={StaticResource B2V}}">
                    <Border Style="{StaticResource Card}" Height="220" ClipToBounds="True">
                        <Image Source="{Binding ImageUrl, Converter={StaticResource UrlImg}}" Stretch="Uniform" Margin="6"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                </Grid>

                <ItemsControl ItemsSource="{Binding Sections}" Margin="26,16,26,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink3}" Margin="0,0,0,6"
                                           Visibility="{Binding HasTitle, Converter={StaticResource B2V}}"/>
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,5">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Key}" FontSize="12"
                                                           Foreground="{DynamicResource Brush.Ink3}"
                                                           TextWrapping="Wrap" VerticalAlignment="Top"/>
                                                <TextBox Grid.Column="1" Style="{StaticResource SelectableText}"
                                                         Text="{Binding Value, Mode=OneWay}" VerticalAlignment="Top"/>
                                                <!-- 动作按钮独立成列，避免压住长文本 -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            VerticalAlignment="Top" Margin="6,0,0,0">
                                                    <Button Content="{Binding OpenLabel}" Style="{StaticResource GhostButton}"
                                                            Foreground="{DynamicResource Brush.Accent}" FontSize="11"
                                                            Command="{Binding OpenLinkCommand}"
                                                            Visibility="{Binding HasLink, Converter={StaticResource B2V}}"/>
                                                    <Button Content="{Binding JumpLabel}" Style="{StaticResource GhostButton}"
                                                            Foreground="{DynamicResource Brush.Accent}" FontSize="11"
                                                            Command="{Binding GotoXlinkCommand}"
                                                            Visibility="{Binding HasXlink, Converter={StaticResource B2V}}"/>
                                                </StackPanel>
                                                <Button Grid.Column="3" Style="{StaticResource IconButton}"
                                                        MinWidth="24" MinHeight="24" FontSize="12"
                                                        Command="{Binding CopyCommand}"
                                                        Margin="4,0,0,0" VerticalAlignment="Top"
                                                        Visibility="{Binding Copyable, Converter={StaticResource B2V}}"
                                                        views:A11y.Name="{Binding CopyA11y}">
                                                    <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE8C8;"/>
                                                </Button>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding FreeTexts}" Margin="26,0,26,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,12">
                                <StackPanel>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}"
                                                MinWidth="24" MinHeight="24" Command="{Binding CopyCommand}"
                                                Visibility="{Binding Copyable, Converter={StaticResource B2V}}"
                                                views:A11y.Name="{Binding CopyA11y}">
                                            <TextBlock Style="{StaticResource GlyphText}" FontSize="12" Text="&#xE8C8;"/>
                                        </Button>
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.Ink2}" VerticalAlignment="Center"
                                                   Visibility="{Binding Title, Converter={StaticResource S2V}}"/>
                                    </DockPanel>
                                    <TextBox Style="{StaticResource SelectableText}" Text="{Binding Text, Mode=OneWay}"
                                             FontSize="13" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Actions}" Margin="26,4,26,0"
                              Visibility="{Binding Actions, Converter={StaticResource C2V}}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{Binding Label}" Margin="0,0,8,8" Padding="12,7" Command="{Binding Invoke}"
                                        Style="{StaticResource PrimaryButton}"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource B2V}}"/>
                                <Button Content="{Binding Label}" Margin="0,0,8,8" Padding="12,7" Command="{Binding Invoke}"
                                        Style="{StaticResource SecondaryButton}"
                                        Visibility="{Binding IsPrimary, Converter={StaticResource InvB2V}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Margin="26,14,26,30" Visibility="{Binding HasXLinks, Converter={StaticResource B2V}}">
                    <TextBlock Text="{Binding CrossLinksLabel}" Style="{StaticResource CaptionText}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding XLinks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Label}" Style="{StaticResource GhostButton}"
                                        HorizontalContentAlignment="Left" Foreground="{DynamicResource Brush.Accent}"
                                        Command="{Binding Goto}" Margin="0,1" Padding="8,5"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= 收藏夹 ================= -->
    <DataTemplate DataType="{x:Type vm:FavoritesVm}">
        <Grid>
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,0,20,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding ExportJsonLabel}" Style="{StaticResource GhostButton}"
                                Command="{Binding ExportJsonCommand}" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="{Binding ExportLabel}" Style="{StaticResource GhostButton}"
                                Command="{Binding ExportTextCommand}" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="{Binding ClearLabel}" Style="{StaticResource DangerButton}"
                                Command="{Binding ClearCommand}"/>
                        <Grid>
                            <TextBox Style="{StaticResource SearchBox}" FontSize="12" MinHeight="28"
                                     views:Placeholder.Text="{Binding FilterPlaceholder}"
                                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                                    MinWidth="24" MinHeight="24" Margin="0,0,3,0"
                                    Command="{Binding ClearFilterCommand}" views:A11y.Name="{Binding ClearLabel}"
                                    Visibility="{Binding HasFilter, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource GlyphText}" FontSize="11" Text="&#xE711;"/>
                            </Button>
                        </Grid>
                    </DockPanel>
                </Border>
                <Grid>
                    <views:ResultList Style="{StaticResource BareListBox}" ItemsSource="{Binding Rows}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <views:ResultList.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.DividerSoft}" BorderThickness="0,0,0,1" Padding="4,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="8,8,4,8">
                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallText}"
                                                       Visibility="{Binding HasSubtitle, Converter={StaticResource B2V}}"
                                                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                            <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}"
                                                       Foreground="{DynamicResource Brush.Ink3}" Margin="0,2,0,0"
                                                       Visibility="{Binding HasNote, Converter={StaticResource B2V}}"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Border Background="{Binding Brush}" CornerRadius="3" Padding="6,1" Style="{StaticResource Chip}">
                                                    <TextBlock Text="{Binding ToolName}" Style="{StaticResource ChipText}" TextWrapping="NoWrap"/>
                                                </Border>
                                                <TextBlock Text="{Binding RelativeTime}" FontSize="11" Margin="8,0,0,0"
                                                           Foreground="{DynamicResource Brush.Ink3}" VerticalAlignment="Center"
                                                           TextWrapping="NoWrap"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Command="{Binding EditNoteCommand}"
                                                    views:A11y.Name="{Binding EditNoteTip}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE70F;"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"
                                                    views:A11y.Name="{Binding DeleteTip}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;"/>
                                            </Button>
                                            <Button Content="{Binding OpenTip}" Style="{StaticResource GhostButton}"
                                                    Foreground="{DynamicResource Brush.Accent}" FontSize="12"
                                                    Command="{Binding OpenCommand}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </views:ResultList.ItemTemplate>
                    </views:ResultList>
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding Empty}"
                               Visibility="{Binding ShowTrueEmpty, Converter={StaticResource B2V}}"/>
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding NoFilterText}"
                               Visibility="{Binding ShowNoFilter, Converter={StaticResource B2V}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- ================= 历史 ================= -->
    <DataTemplate DataType="{x:Type vm:HistoryVm}">
        <Grid>
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,0,20,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding ClearLabel}" Style="{StaticResource DangerButton}"
                                Command="{Binding ClearCommand}" Margin="6,0,0,0"/>
                        <Grid>
                            <TextBox Style="{StaticResource SearchBox}" FontSize="12" MinHeight="28"
                                     views:Placeholder.Text="{Binding FilterPlaceholder}"
                                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}"
                                    MinWidth="24" MinHeight="24" Margin="0,0,3,0"
                                    Command="{Binding ClearFilterCommand}" views:A11y.Name="{Binding ClearLabel}"
                                    Visibility="{Binding HasFilter, Converter={StaticResource B2V}}">
                                <TextBlock Style="{StaticResource GlyphText}" FontSize="11" Text="&#xE711;"/>
                            </Button>
                        </Grid>
                    </DockPanel>
                </Border>
                <Grid>
                    <views:ResultList Style="{StaticResource BareListBox}" ItemsSource="{Binding Rows}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <views:ResultList.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.DividerSoft}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8" VerticalAlignment="Center">
                                            <Border Background="{Binding Brush}" CornerRadius="3" Padding="6,1" Margin="0,0,8,0" Style="{StaticResource Chip}">
                                                <TextBlock Text="{Binding ToolName}" Style="{StaticResource ChipText}" TextWrapping="NoWrap"/>
                                            </Border>
                                            <TextBlock Text="{Binding Query}" FontSize="13" FontFamily="Consolas, Cascadia Mono"
                                                       Foreground="{DynamicResource Brush.Ink2}" TextTrimming="CharacterEllipsis"
                                                       TextWrapping="NoWrap" MaxWidth="220"/>
                                            <TextBlock Text="{Binding RelativeTime}" FontSize="11"
                                                       Foreground="{DynamicResource Brush.Ink3}" Margin="8,0,0,0"
                                                       TextWrapping="NoWrap"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding DataContext.ReSearchLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    Style="{StaticResource GhostButton}" Foreground="{DynamicResource Brush.Accent}"
                                                    FontSize="12" Command="{Binding ReRunCommand}"/>
                                            <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"
                                                    views:A11y.Name="{Binding DeleteTip}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </views:ResultList.ItemTemplate>
                    </views:ResultList>
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding Empty}"
                               Visibility="{Binding ShowTrueEmpty, Converter={StaticResource B2V}}"/>
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding NoFilterText}"
                               Visibility="{Binding ShowNoFilter, Converter={StaticResource B2V}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- ================= 集合 ================= -->
    <DataTemplate DataType="{x:Type vm:CollectionsVm}">
        <Grid>
            <!-- 列表态 -->
            <DockPanel Visibility="{Binding HasSelected, Converter={StaticResource InvB2V}}">
                <Border DockPanel.Dock="Top" Padding="20,0,20,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding ExportAllLabel}" Style="{StaticResource GhostButton}"
                                Command="{Binding ExportAllJsonCommand}" Margin="6,0,0,0"/>
                        <Button DockPanel.Dock="Right" Content="{Binding NewLabel}" Style="{StaticResource PrimaryButton}"
                                Command="{Binding NewCommand}"/>
                        <TextBlock/>
                    </DockPanel>
                </Border>
                <Grid>
                    <views:ResultList Style="{StaticResource BareListBox}" ItemsSource="{Binding Collections}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <views:ResultList.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.DividerSoft}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding OpenCommand}" Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left" Padding="8,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding CountLabel}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding RelativeUpdated}" Style="{StaticResource CaptionText}" Margin="0,2,0,0"/>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Command="{Binding RenameCommand}"
                                                    views:A11y.Name="{Binding RenameTip}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE70F;"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Command="{Binding DeleteCommand}"
                                                    views:A11y.Name="{Binding DeleteTip}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </views:ResultList.ItemTemplate>
                    </views:ResultList>
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding Empty}"
                               Visibility="{Binding ShowListEmpty, Converter={StaticResource B2V}}"/>
                </Grid>
            </DockPanel>

            <!-- 详情态 -->
            <DockPanel Visibility="{Binding HasSelected, Converter={StaticResource B2V}}">
                <Border DockPanel.Dock="Top" Padding="20,0,20,8">
                    <StackPanel>
                        <Button Content="{Binding BackLabel}" Style="{StaticResource GhostButton}"
                                HorizontalAlignment="Left" Command="{Binding BackToListCommand}"/>
                        <DockPanel Margin="0,8,0,0">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="{Binding ExportCsvLabel}" Style="{StaticResource GhostButton}"
                                        Command="{Binding ExportCsvCommand}" Margin="0,0,6,0"/>
                                <Button Content="{Binding VerifyLabel}" Style="{StaticResource SecondaryButton}"
                                        Command="{Binding BatchVerifyCommand}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedTitle}" Style="{StaticResource HeadlineText}" VerticalAlignment="Center"/>
                        </DockPanel>
                        <TextBlock Text="{Binding VerifyHintLabel}" Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0"
                                    Visibility="{Binding Verifying, Converter={StaticResource B2V}}">
                            <ProgressBar IsIndeterminate="True" Style="{StaticResource ThinProgress}" Width="90"
                                         VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding VerifyProgressLabel}" Style="{StaticResource CaptionText}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Grid>
                    <views:ResultList Style="{StaticResource BareListBox}" ItemsSource="{Binding SelectedEntries}"
                                      HorizontalContentAlignment="Stretch"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <views:ResultList.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Brush.DividerSoft}" BorderThickness="0,0,0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding OpenCommand}" Style="{StaticResource GhostButton}"
                                                HorizontalContentAlignment="Left" Padding="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource Brush.Ink}" TextTrimming="CharacterEllipsis"
                                                           TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Subtitle}" Style="{StaticResource SmallText}"
                                                           Visibility="{Binding HasSubtitle, Converter={StaticResource B2V}}"
                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                <TextBlock Text="{Binding Note}" Style="{StaticResource CaptionText}"
                                                           Visibility="{Binding HasNote, Converter={StaticResource B2V}}" Margin="0,2,0,0"/>
                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                    <Border Background="{Binding Brush}" CornerRadius="3" Padding="6,1" Style="{StaticResource Chip}">
                                                        <TextBlock Text="{Binding ToolName}" Style="{StaticResource ChipText}" TextWrapping="NoWrap"/>
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Command="{Binding EditNoteCommand}"
                                                    views:A11y.Name="{Binding DataContext.EntryNoteLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE70F;"/>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Command="{Binding RemoveCommand}"
                                                    views:A11y.Name="{Binding DataContext.RemoveLabel, RelativeSource={RelativeSource AncestorType=ItemsControl}}">
                                                <TextBlock Style="{StaticResource GlyphText}" Text="&#xE74D;"/>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </views:ResultList.ItemTemplate>
                    </views:ResultList>
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding SelectedEmpty}"
                               Visibility="{Binding ShowSelectionEmpty, Converter={StaticResource B2V}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DataTemplate>

    <!-- ================= 设置 ================= -->
    <DataTemplate DataType="{x:Type vm:SettingsVm}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,8,28,40">
                <TextBlock Text="{Binding AppearanceSection}" Style="{StaticResource SectionHeaderText}"/>
                <TextBlock Text="{Binding ThemeLabel}" Style="{StaticResource CaptionText}" Margin="0,4,0,6"/>
                <WrapPanel>
                    <RadioButton GroupName="theme" Content="{Binding ThemeSystem}" Style="{StaticResource PillRadioStyle}"
                                 Margin="0,0,6,6" ToolTip="System"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource StrEq}, ConverterParameter=System}"/>
                    <RadioButton GroupName="theme" Content="{Binding ThemeLight}" Style="{StaticResource PillRadioStyle}"
                                 Margin="0,0,6,6" ToolTip="Light"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource StrEq}, ConverterParameter=Light}"/>
                    <RadioButton GroupName="theme" Content="{Binding ThemeDark}" Style="{StaticResource PillRadioStyle}"
                                 Margin="0,0,6,6" ToolTip="Dark"
                                 IsChecked="{Binding SelectedTheme, Converter={StaticResource StrEq}, ConverterParameter=Dark}"/>
                </WrapPanel>

                <TextBlock Text="{Binding DensityLabel}" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/>
                <WrapPanel>
                    <RadioButton GroupName="dens" Content="{Binding DensityCompact}" Style="{StaticResource PillRadioStyle}"
                                 Margin="0,0,6,6" ToolTip="Compact"
                                 IsChecked="{Binding SelectedDensity, Converter={StaticResource StrEq}, ConverterParameter=Compact}"/>
                    <RadioButton GroupName="dens" Content="{Binding DensityNormal}" Style="{StaticResource PillRadioStyle}"
                                 Margin="0,0,6,6" ToolTip="Normal"
                                 IsChecked="{Binding SelectedDensity, Converter={StaticResource StrEq}, ConverterParameter=Normal}"/>
                    <RadioButton GroupName="dens" Content="{Binding DensitySpacious}" Style="{StaticResource PillRadioStyle}"
                                 Margin="0,0,6,6" ToolTip="Spacious"
                                 IsChecked="{Binding SelectedDensity, Converter={StaticResource StrEq}, ConverterParameter=Spacious}"/>
                </WrapPanel>

                <TextBlock Text="{Binding LanguageLabel}" Style="{StaticResource CaptionText}" Margin="0,14,0,6"/>
                <WrapPanel>
                    <RadioButton GroupName="lang" Content="中文" Style="{StaticResource PillRadioStyle}" Margin="0,0,6,6"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource StrEq}, ConverterParameter=zh}"/>
                    <RadioButton GroupName="lang" Content="English" Style="{StaticResource PillRadioStyle}" Margin="0,0,6,6"
                                 IsChecked="{Binding SelectedLanguage, Converter={StaticResource StrEq}, ConverterParameter=en}"/>
                </WrapPanel>

                <Border Style="{StaticResource HDivider}"/>
                <TextBlock Text="{Binding CacheSection}" Style="{StaticResource SectionHeaderText}"/>
                <CheckBox Style="{StaticResource ThemedCheckBox}" Content="{Binding EnableCacheLabel}"
                          IsChecked="{Binding CacheEnabled, Mode=TwoWay}" Margin="0,0,0,4"/>
                <TextBlock Text="{Binding CacheStateLabel}" Style="{StaticResource CaptionText}" Margin="0,0,0,10"/>
                <WrapPanel>
                    <Button Content="{Binding ClearCacheLabel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearCacheCommand}" Margin="0,0,8,8"/>
                    <Button Content="{Binding ShortcutsLabel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ShowShortcutsCommand}" Margin="0,0,8,8"/>
                </WrapPanel>

                <Border Style="{StaticResource HDivider}"/>
                <TextBlock Text="{Binding DataSection}" Style="{StaticResource SectionHeaderText}"/>
                <WrapPanel>
                    <Button Content="{Binding ExportAllLabel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ExportAllCommand}" Margin="0,0,8,8"/>
                    <Button Content="{Binding ClearFavoritesLabel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearFavoritesCommand}" Margin="0,0,8,8"/>
                    <Button Content="{Binding ClearHistoryLabel}" Style="{StaticResource SecondaryButton}"
                            Command="{Binding ClearHistoryCommand}" Margin="0,0,8,8"/>
                    <Button Content="{Binding ResetLabel}" Style="{StaticResource DangerButton}"
                            Command="{Binding ResetAppCommand}" Margin="0,0,8,8"/>
                </WrapPanel>

                <Border Style="{StaticResource HDivider}"/>
                <TextBlock Text="{Binding AboutSection}" Style="{StaticResource SectionHeaderText}"/>
                <TextBlock Text="{Binding AboutText}" Style="{StaticResource SmallText}"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <TextBlock Text="{Binding VersionLabel}" Style="{StaticResource CaptionText}" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding VersionValue}" Style="{StaticResource CaptionText}" Margin="6,0,0,0" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding OsLabel}" Style="{StaticResource CaptionText}" Margin="16,0,0,0" TextWrapping="NoWrap"/>
                    <TextBlock Text="{Binding OsValue}" Style="{StaticResource CaptionText}" Margin="6,0,0,0" TextWrapping="NoWrap"/>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </DataTemplate>

    <!-- ================= 全局搜索 ================= -->
    <DataTemplate DataType="{x:Type vm:GlobalSearchVm}">
        <Grid>
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="20,4,20,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="{Binding RetryLabel}" Style="{StaticResource GhostButton}"
                                Command="{Binding ReRunCommand}" Margin="6,0,0,0"/>
                        <TextBlock Text="{Binding QueryLabel}" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <ProgressBar IsIndeterminate="True" Style="{StaticResource ThinProgress}" Width="120"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding Loading, Converter={StaticResource B2V}}"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding Loading, Converter={StaticResource InvB2V}}">
                        <ItemsControl ItemsSource="{Binding Groups}" Margin="0,4,0,30">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="20,10,20,0">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Border Background="{Binding Brush}" Width="16" Height="16" CornerRadius="4" Style="{StaticResource Chip}">
                                                <TextBlock Text="{Binding Abbrev}" Style="{StaticResource ChipText}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource CaptionText}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <Border Style="{StaticResource Card}">
                                            <ItemsControl ItemsSource="{Binding Providers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border BorderBrush="{DynamicResource Brush.DividerSoft}"
                                                                BorderThickness="0,0,0,1" Padding="12,8">
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Button DockPanel.Dock="Right" Content="{Binding OpenLabel}"
                                                                            Style="{StaticResource GhostButton}"
                                                                            Foreground="{DynamicResource Brush.Accent}" FontSize="12"
                                                                            Command="{Binding OpenInToolCommand}"/>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource GlyphText}"
                                                                   FontSize="13" Foreground="{Binding Brush}" VerticalAlignment="Center" Margin="0"/>
                                                                        <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                                                   Margin="7,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                                        <TextBlock Text="{Binding CountLabel}" Style="{StaticResource CaptionText}"
                                                                                   Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                                                                    </StackPanel>
                                                                </DockPanel>
                                                                <ItemsControl ItemsSource="{Binding TopItems}" Margin="0,4,0,0"
                                                                              Visibility="{Binding HasItems, Converter={StaticResource B2V}}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                                                <TextBlock Text="{Binding Badge}" FontSize="11"
                                                                                           FontFamily="Consolas, Cascadia Mono"
                                                                                           Foreground="{DynamicResource Brush.Ink3}" Width="90"
                                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                                <TextBlock Text="{Binding Title}" FontSize="12"
                                                                                           Foreground="{DynamicResource Brush.Ink2}"
                                                                                           TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                                                            </StackPanel>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Text="{Binding MoreLabel}" Style="{StaticResource CaptionText}"
                                                                           Margin="0,2,0,0" Visibility="{Binding HasMoreItems, Converter={StaticResource B2V}}"/>
                                                                <TextBlock Text="{Binding FailLabel}" Style="{StaticResource CaptionText}"
                                                                           Foreground="{DynamicResource Brush.SemanticWarning}" Margin="0,4,0,0"
                                                                           Visibility="{Binding ShowFail, Converter={StaticResource B2V}}"/>
                                                                <TextBlock Text="{Binding EmptyLabel}" Style="{StaticResource CaptionText}"
                                                                           Margin="0,4,0,0" Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Style="{StaticResource EmptyStateText}" Text="{Binding EmptyLabel}"
                               Visibility="{Binding ShowEmpty, Converter={StaticResource B2V}}"/>
                </Grid>
            </DockPanel>
        </Grid>
    </DataTemplate>

</ResourceDictionary>
